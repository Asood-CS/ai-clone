# Replace placeholders with real secrets for effective app deployment.

# OpenAI
OPENAI_API_KEY=sk-REPLACE_WITH_REAL_OPENAI_KEY

# ElevenLabs TTS
ELEVENLABS_API_KEY=REPLACE_WITH_REAL_ELEVENLABS_KEY

# D-ID API credentials (username/password or API key depending on D-ID usage)
DID_USERNAME=did_username_here
DID_PWD=did_password_here
DID_API_KEY=did_api_key_here

# Dropbox
DBX_ACCESS_TOKEN=sl.ABCDEF1234567890

# Local paths (for development only). These should be relative paths inside repo or to a writable tmp dir.
OUTPUT_AUDIO_PATH=output_audio.wav
REFERENCE_IMAGE_PATH=reference_image.jpg
FINAL_VIDEO_PATH=final_video.mp4
DEFAULT_FALLBACK_VIDEO=video_1.mp4

# Optional: Set this to "true" during local dev to auto-load .env with python-dotenv
USE_DOTENV=true
